# ─────────────────────────────────────────
#  Ripple Bot — Environment Variables
#  Copy this to .env and fill in your values.
#  NEVER share your .env or commit it to GitHub!
# ─────────────────────────────────────────

# Your bot token from https://discord.com/developers/applications
BOT_TOKEN=your_bot_token_here

# Right-click the Silent Study Room voice channel → Copy Channel ID
VOICE_CHANNEL_ID=123456789012345678

# Right-click your dedicated now-playing text channel → Copy Channel ID
NOW_PLAYING_CHANNEL_ID=123456789012345678

# Comma separated list of text channel IDs where bot commands are allowed
# Add as many as you want, no spaces needed
TEXT_CHANNEL_IDS=123456789012345678,987654321098765432
